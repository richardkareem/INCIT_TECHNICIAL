SELECT * FROM User;

SELECT COUNT(email) FROM User WHERE email = &quot;mail@mail.com&quot;;

UPDATE User set email = &quot;awikwok@mail.com&quot; WHERE id_user = 1;

INSERT INTO expense (id_user, name, id_category) VALUES (1, &quot;Jam Tangan&quot;, 1 );

SELECT * FROM expense;

DELETE FROM expense where id_user = 1;



/* DESC */
PRAGMA table_info(icon);
PRAGMA table_info(category);

INSERT INTO category (name, icon) VALUES (&quot;Jajan&quot;, &quot;https://example.com&quot;);
SELECT * from category;

SELECT id, full_name, email, password, name as expense
FROM expense
INNER JOIN User ON expense.id_user = User.id_user
WHERE expense.id_user = User.id_user;

SELECT expense.id, full_name,expense.name as expense
FROM expense
INNER JOIN User on expense.id_user = User.id_user
INNER JOIN category on expense.id_category = category.id;</sql><current_tab id="0"/></tab_sql></sqlb_project>
